{
    "name": "wintrchess",
    "version": "1.0.0",
    "private": true,
    "description": "A website that analyses Chess games with move classifications, for free.",
    "author": "WintrChess",
    "main": "desktop/main.cjs",
    "scripts": {
        "start": "node app/http/dist/http/src/index.js",
        "start:desktop": "electron .",
        "icons": "node scripts/make-icons.cjs",
        "smoke:desktop": "node scripts/smoke-desktop-server.cjs",
        "android:web": "node scripts/build-android-web.cjs",
        "app:win": "npm run build && npm run icons && electron-builder --win nsis --x64",
        "app:android": "npm run build && npm run android:web && cap sync android",
        "app:android:apk": "npm run app:android && node scripts/build-android-apk.cjs",
        "build": "npm run build:server && npm run build:client",
        "build:server": "tsc -p app/http/tsconfig.json && tsc-alias -f -p app/http/tsconfig.json",
        "build:client": "cd app/ui && webpack",
        "check": "tsc --noEmit -p app/ui/tsconfig.json && tsc --noEmit -p app/http/tsconfig.json",
        "dev": "npm run build && npm start",
        "lint": "eslint ."
    },
    "dependencies": {
        "@capacitor/android": "^8.5.2",
        "@capacitor/core": "^8.5.2",
        "@mliebelt/pgn-parser": "^1.4.18",
        "chess.js": "^1.4.0",
        "compress-json": "^3.2.0",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "http-status-codes": "^2.3.0",
        "lodash-es": "^4.17.21",
        "react": "^18.3.1",
        "react-chessboard": "^4.7.3",
        "react-dom": "^18.3.1",
        "uuid": "^10.0.0",
        "zod": "^4.0.10",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@babel/cli": "^7.26.4",
        "@babel/core": "^7.26.10",
        "@babel/preset-env": "^7.26.9",
        "@babel/preset-react": "^7.24.6",
        "@babel/preset-typescript": "^7.26.0",
        "@capacitor/cli": "^8.5.2",
        "@lichess-org/types": "^2.0.48",
        "@stylistic/eslint-plugin-ts": "^2.1.0",
        "@tanstack/react-query": "^5.50.1",
        "@types/express": "^4.17.21",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^20.12.12",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@types/uuid": "^10.0.0",
        "babel-loader": "^9.1.3",
        "css-loader": "^7.1.2",
        "dotenv-webpack": "^8.1.0",
        "electron": "^44.6.0",
        "electron-builder": "^26.15.3",
        "eslint": "^8.57.1",
        "i18next": "^23.11.5",
        "i18next-http-backend": "^3.0.2",
        "immer": "^10.1.1",
        "jsdom": "^30.1.2",
        "react-colorful": "^5.6.1",
        "react-cookie": "^7.1.4",
        "react-hotkeys-hook": "^4.6.1",
        "react-i18next": "^14.1.2",
        "react-markdown": "^9.0.1",
        "react-router-dom": "^6.30.1",
        "react-select": "^5.10.0",
        "react-switch": "^7.1.0",
        "react-toastify": "^11.0.2",
        "react-tooltip": "^5.28.1",
        "recharts": "^2.15.3",
        "style-loader": "^4.0.0",
        "tsc-alias": "^1.8.16",
        "typescript": "^5.4.5",
        "typescript-eslint": "^7.12.0",
        "webpack": "^5.91.0",
        "webpack-bundle-analyzer": "^4.10.2",
        "webpack-cli": "^5.1.4"
    }
}
